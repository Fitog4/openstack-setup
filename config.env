# Shared settings for init.sh / up.sh / down.sh
# Keep secrets out of this file: OpenStack credentials come from clouds.yaml
# (OS_CLOUD) or from the application-credential openrc file.

# --- OpenStack auth ---------------------------------------------------------
# Name of the entry in ~/.config/openstack/clouds.yaml. Leave empty if you
# source an openrc file instead.
# OS_CLOUD="${OS_CLOUD:-leafcloud}"

# --- Instance ---------------------------------------------------------------
FLAVOR="en1.small"
IMAGE_ID="a924a90e-83ed-4375-af94-582e514d89e7"   # Ubuntu-26.04
SERVER_NAME="ai-test"

# --- Access -----------------------------------------------------------------
KEY_NAME="ai-key"
PUBKEY_FILE="$HOME/.ssh/id_ed25519.pub"
SG_NAME="ai-sg"
# TCP ports opened to ALLOWED_CIDR (space separated). 22 = SSH.
SG_TCP_PORTS="22"
# Leave empty to auto-detect your current public IPv4 (/32) at init time.
ALLOWED_CIDR=""

# --- Network ----------------------------------------------------------------
NET_NAME="ai-net"
SUBNET_NAME="ai-subnet"
SUBNET_RANGE="10.20.0.0/24"
ROUTER_NAME="ai-router"
# Leave empty to auto-detect the first external network.
EXTERNAL_NET=""

# --- Object storage (optional) ---------------------------------------------
# 1 = create the container (Swift API) in init.sh. down.sh backs up into it.
CREATE_BUCKET=1
BUCKET_NAME="ai-private-data"

# --- SSH --------------------------------------------------------------------
# Default login user of the Ubuntu image.
SSH_USER="ubuntu"
# Private key matching PUBKEY_FILE (default: PUBKEY_FILE without .pub).
SSH_KEY=""

# --- Backup / restore (down.sh / up.sh) -------------------------------------
# Directory on the VM that down.sh archives into the bucket.
BACKUP_REMOTE_DIR="/srv/ai-data"
# 1 = encrypt the archive locally with age before upload (recommended).
# Install with: sudo apt install age ; create a key with: age-keygen -o age-key.txt
BACKUP_ENCRYPT=1
AGE_RECIPIENT="age1mgxr3thaav325j3ken9mz4tnp88jt2nwde68uvw63vrw59tjmyjqd9hhhw" # public key, starts with "age1..."
AGE_IDENTITY="./age-key.txt"     # private key file, used only for restore
# 1 = up.sh restores the newest backup from the bucket onto the new VM.
RESTORE_LATEST=0
